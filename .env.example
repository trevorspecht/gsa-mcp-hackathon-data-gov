# Local development: loaded from the project root. Never commit .env.
# direct = public catalog JSON interface; gateway = keyed api.gsa.gov v4.
# No automatic failover between interfaces. Gateway requires your own API key.
CATALOG_INTERFACE=direct
DATA_GOV_API_KEY=
# Conservative per-process outbound request budget, shared by all catalog tools.
CATALOG_REQUESTS_PER_HOUR=60

# HTTPS workspace origin, without an API path or query string.
DATABRICKS_HOST=
# SQL warehouse ID (not the /sql/1.0/warehouses/... HTTP path).
DATABRICKS_WAREHOUSE_ID=
# Local email-code/browser login: set profile=hackathon after CLI OAuth login.
# Leave token/client ID/client secret blank when using a profile.
DATABRICKS_CONFIG_PROFILE=
# Alternatives: warehouse token OR App-injected OAuth client credentials.
DATABRICKS_TOKEN=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Existing catalog/schema that the operator may use for the curated snapshot.
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_TABLE=county_indicators
# Set after preparing and loading a verified snapshot. Relative to project root.
ANALYTICS_MANIFEST=.local/data/manifest.json
EVIDENCE_DIR=.local/evidence

# stdio is the default. Databricks Apps sets DATABRICKS_APP_PORT itself.
MCP_TRANSPORT=stdio
# Used only for an explicitly selected local HTTP transport.
MCP_PORT=8000

# Databricks agent client (fill after App creation).
DATABRICKS_MCP_URL=
DATABRICKS_MODEL_ENDPOINT=
# chat uses serving endpoint names; responses uses e.g. system.ai.gpt-6-1-sol.
AGENT_API=chat
AGENT_MAX_OUTPUT_TOKENS=4000
AGENT_REASONING_EFFORT=low
# Agent authentication uses OAuth client credentials above or the same CLI OAuth profile.
# A PAT can query a warehouse but cannot authenticate to a Databricks App.
